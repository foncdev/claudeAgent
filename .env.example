# 서버와 클라이언트가 함께 읽는 설정. 복사해서 .env로 쓴다.
#   cp .env.example .env
# 셸에 이미 설정된 변수가 우선한다.

# 워크스페이스 허용 루트. ':'로 여러 개 지정
AGENT_ALLOWED_ROOTS=~/develop

# 설정하면 모든 요청에 x-api-key 헤더 필요.
# 비워두면 이 기기 주소(127.0.0.1)로만 받고, HOST를 밖으로 열면 매니저가 뜨지 않는다.
# 만들기: openssl rand -hex 24
AGENT_API_KEY=

PORT=4000
HOST=127.0.0.1
AGENT_MAX_CONCURRENT=3
AGENT_TIMEOUT_MS=1800000

# 클라이언트 전용
# AGENT_URL=http://127.0.0.1:4000
# AGENT_MODEL=sonnet
# AGENT_PERMISSION_MODE=acceptEdits
